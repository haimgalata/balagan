# Copy to `.env.local` (git-ignored) and fill in. Vite bakes these into the build, so set the
# same variables in your hosting provider's build settings for production.
#
# Only PUBLIC values belong here. NEVER put the Supabase `service_role` key in any env file
# of this project — the storefront and the admin use the anon / publishable key only.

# Project URL and anon (or publishable) key: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the storefront reads its catalog from:
#   supabase  (default when the two values above are set) = live catalog from the database
#   static    = the catalog bundled in src/data (instant rollback / offline fallback)
VITE_CATALOG_SOURCE=supabase
