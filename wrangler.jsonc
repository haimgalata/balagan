// Cloudflare Workers (static assets) — how the site is served in production.
// `npm run build` writes the static site to dist/; `npx wrangler deploy` uploads it. There is no server code:
// Supabase is called straight from the browser. "single-page-application" serves index.html for any unknown path,
// so /admin, /checkout and /order/<id> work when opened directly or refreshed (the SPA fallback CLAUDE.md asks for).
// The VITE_* values are BUILD variables (set in the Cloudflare dashboard), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balagan",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
